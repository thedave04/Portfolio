<!--  ################ Verse Finder ################ -->
<div
	onclick="document.getElementById('VerseFinder').classList.toggle('hidden')"
	class="bg-white text-black rounded-full text-left p-10 mb-10 cursor-pointer"
>
	<div class="grid grid-cols-20 gap-4">
		<svg
			xmlns="http://www.w3.org/2000/svg"
			fill="none"
			viewBox="0 0 24 24"
			stroke-width="1.5"
			stroke="currentColor"
			class="size-6"
		>
			<path
				stroke-linecap="round"
				stroke-linejoin="round"
				d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
		</svg>
		<h3 class="text-2xl font-bold col-span-6">
			VerseFinder
		</h3>
		<h3 class="text-sm font-bold text-right col-span-13">
			React Native, Expo, TypeScript, AWS Lambda, Python,
			SQLite
			<br />React, FastAPI
		</h3>
	</div>
</div>
<div
	id="VerseFinder"
	class="hidden bg-white text-black rounded-lg text-left p-10 mb-10"
>
	<div class="grid grid-cols-3 gap-4 mb-4">
		<div>
			<ul class="list-none pr-5">
				<li class="mb-10">
					Initially created a cross-platform mobile
					app that allows users to find Bible verses
					similar to other verses or based on specific
					topics.
				</li>
				<li class="mb-10">
					Later developed into a web application with
					React and FastAPI and deployed <a
						style="color: blue; text-decoration: underline;"
						href="https://versefinder.netlify.app/"
						target="_blank"
						>here</a
					>.
				</li>
				<li>
					Uses Sentence Transformers' all-MiniLM-L6-v2
					pretrained sentence embedding model to map
					verses to vectors.
				</li>
			</ul>
		</div>
		<img
			class="object-contain"
			src="/Portfolio/images/VerseFinderPhotos/Menu.png"
			alt="Menu"
		/>
		<img
			class="object-contain"
			src="/Portfolio/images/VerseFinderPhotos/AnyScreen.png"
			alt="AnyScreen"
		/>
		<img
			class="object-contain"
			src="/Portfolio/images/VerseFinderPhotos/AnyResults.png"
			alt="AnyResults"
		/>
		<img
			class="object-contain col-span-2"
			src="/Portfolio/images/VerseFinderPhotos/WebApp.png"
			alt="VerseFinderWebApp"
		/>
	</div>
</div>
