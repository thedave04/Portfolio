---
import "../styles/global.css";
import PersonalProjectsSection from "../components/projects/personal/PersonalProjectsSection.astro";
import ClassProjectsSection from "../components/projects/class/ClassProjectsSection.astro";
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link
			rel="icon"
			type="image/x-icon"
			href="/Portfolio/images/AppIcon.png"
		/>
		<title>David Ambriz | Portfolio</title>
	</head>
	<body class="relative bg-black text-white font-mono starfield min-h-screen">
		<img
			src="/Portfolio/images/AppIcon.png"
			alt="App Icon"
			class="fixed top-4 right-4 w-25 h-25 z-50"
		/>
		<main class="relative flex flex-col max-w-4xl mx-auto pt-70">
			<section class="mb-15 text-center">
				<img
					src="/Portfolio/images/Headshot.jpeg"
					alt="Profile Picture"
					class="rounded-full w-50 h-50 mx-auto mb-12 object-cover"
				/>
				<h1
					class="text-2xl sm:text-4xl md:text-5xl font-bold mb-4 whitespace-nowrap overflow-hidden"
				>
					<span
						class="inline-block animate-[var(--animate-typewriter)] overflow-hidden"
						>Howdy, I'm David Ambriz.</span
					><span
						class="inline-block border-r-4 h-[1em] animate-[var(--animate-blink)]"
					></span>
				</h1>
				<p>
					I'm a senior computer science student at Texas A&M
					University.
				</p>
				<div class="bg-white text-black rounded-full mt-8 inline-flex items-center gap-2 px-6 py-3">
					<a
						href="https://www.linkedin.com/in/davidambriz"
						target="_blank"
						id="linkedin-link"
						class="font-bold text-lg"
					>LinkedIn</a>
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
						<path fill="currentColor" d="M14 5a1 1 0 1 1 0-2h6a1 1 0 0 1 1 1v6a1 1 0 1 1-2 0V6.414l-9.293 9.293a1 1 0 0 1-1.414-1.414L17.586 5zM3 7a2 2 0 0 1 2-2h5a1 1 0 1 1 0 2H5v12h12v-5a1 1 0 1 1 2 0v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
					</svg>
				</div>
			</section>
			<section class="mb-10">
				<PersonalProjectsSection />
				<ClassProjectsSection />
			</section>
		</main>
	</body>
</html>
